# Gemini API Configuration
# Copy this file to .env and replace the placeholder with your actual Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Modal Serverless Whisper Endpoint (e.g., https://username--whisper-transcribe-fastapi-app.modal.run/transcribe)
MODAL_TRANSCRIBE_URL=your_modal_transcribe_url_here

