# OpenRouter API Configuration
# Copy this file to .env and replace the placeholder with your actual OpenRouter API Key
OPENROUTER_API_KEY=your_open_router_api_key_here

# Modal Serverless Whisper Endpoint (e.g., https://username--whisper-transcribe-fastapi-app.modal.run/transcribe)
MODAL_TRANSCRIBE_URL=your_modal_transcribe_url_here

